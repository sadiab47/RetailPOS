generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id             Int                    @id @default(autoincrement())
  name           String
  email          String                 @unique
  passwordHash   String                 @map("password_hash")
  role           String                 @default("cashier")
  createdAt      DateTime               @default(now()) @map("created_at")
  transactions   InventoryTransaction[]
  purchaseOrders PurchaseOrder[]
  createdCustomers Customer[]
  createdCreditLedgers CustomerCreditLedger[]
  createdReturns       SalesReturn[]
  shifts               CashShift[]
  createdMovements     CashMovement[]

  @@map("users")
}

model Category {
  id          Int       @id @default(autoincrement())
  name        String
  description String?   @db.Text
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  products    Product[]

  @@map("categories")
}

model Product {
  id                 Int                    @id @default(autoincrement())
  barcode            String                 @unique
  name               String
  categoryId         Int?                   @map("category_id")
  category           Category?              @relation(fields: [categoryId], references: [id])
  supplierId         Int?                   @map("supplier_id")
  supplier           Supplier?              @relation(fields: [supplierId], references: [id])
  costPrice          Decimal                @default(0) @map("cost_price") @db.Decimal(10, 2)
  sellingPrice       Decimal                @default(0) @map("selling_price") @db.Decimal(10, 2)
  stock              Int                    @default(0)
  lowStockThreshold  Int                    @default(10) @map("low_stock_threshold")
  sku                String?
  isActive           Boolean                @default(true) @map("is_active")
  createdAt          DateTime               @default(now()) @map("created_at")
  updatedAt          DateTime               @updatedAt @map("updated_at")
  saleItems          SaleItem[]
  transactions       InventoryTransaction[]
  purchaseOrderItems PurchaseOrderItem[]
  returnItems        SalesReturnItem[]

  @@map("products")
}

model Supplier {
  id             Int             @id @default(autoincrement())
  companyName    String          @map("company_name")
  contactPerson  String?         @map("contact_person")
  phone          String?
  email          String?
  address        String?         @db.Text
  isActive       Boolean         @default(true) @map("is_active")
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")
  products       Product[]
  purchaseOrders PurchaseOrder[]

  @@map("suppliers")
}

model InventoryTransaction {
  id              Int      @id @default(autoincrement())
  productId       Int      @map("product_id")
  product         Product  @relation(fields: [productId], references: [id])
  transactionType String   @map("transaction_type") // e.g. PURCHASE, SALE, ADJUSTMENT, RETURN, DAMAGE, TRANSFER, INITIAL_STOCK
  quantityChange  Int      @map("quantity_change")
  quantityBefore  Int      @map("quantity_before")
  quantityAfter   Int      @map("quantity_after")
  referenceType   String?  @map("reference_type")
  referenceId     Int?     @map("reference_id")
  remarks         String?  @db.Text
  createdBy       Int?     @map("created_by")
  creator         User?    @relation(fields: [createdBy], references: [id])
  createdAt       DateTime @default(now()) @map("created_at")

  @@map("inventory_transactions")
}

model PurchaseOrder {
  id          Int                 @id @default(autoincrement())
  supplierId  Int                 @map("supplier_id")
  supplier    Supplier            @relation(fields: [supplierId], references: [id])
  orderDate   DateTime            @default(now()) @map("order_date")
  status      String              @default("PENDING") // e.g. PENDING, RECEIVED, CANCELLED
  totalAmount Decimal             @default(0) @map("total_amount") @db.Decimal(10, 2)
  createdBy   Int?                @map("created_by")
  creator     User?               @relation(fields: [createdBy], references: [id])
  items       PurchaseOrderItem[]

  @@map("purchase_orders")
}

model PurchaseOrderItem {
  purchaseOrderId Int           @map("purchase_order_id")
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  productId       Int           @map("product_id")
  product         Product       @relation(fields: [productId], references: [id])
  quantity        Int
  unitCost        Decimal       @map("unit_cost") @db.Decimal(10, 2)

  @@id([purchaseOrderId, productId])
  @@map("purchase_order_items")
}

model Sale {
  id            Int           @id @default(autoincrement())
  invoiceNumber String        @unique @map("invoice_number")
  customerId    Int?          @map("customer_id")
  customer      Customer?     @relation(fields: [customerId], references: [id])
  customerName  String?       @map("customer_name")
  paymentMethod String?       @map("payment_method")
  subtotal      Decimal       @default(0) @db.Decimal(10, 2)
  tax           Decimal       @default(0) @db.Decimal(10, 2)
  discount      Decimal       @default(0) @db.Decimal(10, 2)
  total         Decimal       @default(0) @db.Decimal(10, 2)
  createdAt     DateTime      @default(now()) @map("created_at")
  items         SaleItem[]
  returns       SalesReturn[]

  @@map("sales")
}

model SaleItem {
  id          Int               @id @default(autoincrement())
  saleId      Int               @map("sale_id")
  sale        Sale              @relation(fields: [saleId], references: [id])
  productId   Int               @map("product_id")
  product     Product           @relation(fields: [productId], references: [id])
  quantity    Int
  unitPrice   Decimal           @map("unit_price") @db.Decimal(10, 2)
  returnItems SalesReturnItem[]

  @@map("sale_items")
}

model Customer {
  id                 Int       @id @default(autoincrement())
  customerCode       String    @unique @map("customer_code")
  firstName          String    @map("first_name")
  lastName           String?   @map("last_name")
  phone              String    @unique
  email              String?
  address            String?   @db.Text
  dateOfBirth        DateTime? @map("date_of_birth") @db.Date
  notes              String?   @db.Text
  loyaltyPoints      Int       @default(0) @map("loyalty_points")
  creditLimit        Decimal   @default(0.00) @map("credit_limit") @db.Decimal(10, 2)
  outstandingBalance Decimal   @default(0.00) @map("outstanding_balance") @db.Decimal(10, 2)
  isActive           Boolean   @default(true) @map("is_active")
  createdBy          Int?      @map("created_by")
  creator            User?     @relation(fields: [createdBy], references: [id])
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")
  sales              Sale[]
  loyaltyLedger      CustomerLoyaltyLedger[]
  creditLedger       CustomerCreditLedger[]

  @@index([phone])
  @@index([customerCode])
  @@index([email])
  @@map("customers")
}

model CustomerLoyaltyLedger {
  id              Int      @id @default(autoincrement())
  customerId      Int      @map("customer_id")
  customer        Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  pointsChange    Int      @map("points_change")
  transactionType String   @map("transaction_type") // EARNED, REDEEMED, EXPIRED, ADJUSTED, BONUS
  referenceType   String?  @map("reference_type")
  referenceId     Int?     @map("reference_id")
  remarks         String?  @db.Text
  createdAt       DateTime @default(now()) @map("created_at")

  @@map("customer_loyalty_ledger")
}

model CustomerCreditLedger {
  id              Int      @id @default(autoincrement())
  customerId      Int      @map("customer_id")
  customer        Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  amountChange    Decimal  @map("amount_change") @db.Decimal(10, 2)
  transactionType String   @map("transaction_type") // SALE, PAYMENT, ADJUSTMENT, WRITE_OFF
  referenceType   String?  @map("reference_type")
  referenceId     Int?     @map("reference_id")
  remarks         String?  @db.Text
  createdBy       Int?     @map("created_by")
  creator         User?    @relation(fields: [createdBy], references: [id], onDelete: SetNull)
  createdAt       DateTime @default(now()) @map("created_at")

  @@map("customer_credit_ledger")
}

model SalesReturn {
  id           Int               @id @default(autoincrement())
  saleId       Int               @map("sale_id")
  sale         Sale              @relation(fields: [saleId], references: [id], onDelete: Restrict)
  returnNumber String            @unique @map("return_number")
  status       String            @default("COMPLETED")
  reasonCode   String            @map("reason_code")
  reasonNotes  String?           @map("reason_notes") @db.Text
  refundAmount Decimal           @map("refund_amount") @db.Decimal(10, 2)
  refundMethod String            @default("CASH") @map("refund_method")
  createdBy    Int?              @map("created_by")
  creator      User?             @relation(fields: [createdBy], references: [id], onDelete: SetNull)
  createdAt    DateTime          @default(now()) @map("created_at")
  items        SalesReturnItem[]

  @@map("sales_returns")
}

model SalesReturnItem {
  id         Int         @id @default(autoincrement())
  returnId   Int         @map("return_id")
  return     SalesReturn @relation(fields: [returnId], references: [id], onDelete: Cascade)
  saleItemId Int         @map("sale_item_id")
  saleItem   SaleItem    @relation(fields: [saleItemId], references: [id], onDelete: Restrict)
  productId  Int         @map("product_id")
  product    Product     @relation(fields: [productId], references: [id], onDelete: Restrict)
  quantity   Int
  unitPrice  Decimal     @map("unit_price") @db.Decimal(10, 2)

  @@map("sales_return_items")
}

model CashRegister {
  id        Int         @id @default(autoincrement())
  name      String
  status    String      @default("ACTIVE")
  createdAt DateTime    @default(now()) @map("created_at")
  updatedAt DateTime    @updatedAt @map("updated_at")
  shifts    CashShift[]

  @@map("cash_registers")
}

model CashShift {
  id          Int            @id @default(autoincrement())
  registerId  Int            @map("register_id")
  register    CashRegister   @relation(fields: [registerId], references: [id], onDelete: Restrict)
  userId      Int            @map("user_id")
  user        User           @relation(fields: [userId], references: [id], onDelete: Restrict)
  openingTime DateTime       @default(now()) @map("opening_time")
  closingTime DateTime?      @map("closing_time")
  openingCash Decimal        @map("opening_cash") @db.Decimal(10, 2)
  closingCash Decimal?       @map("closing_cash") @db.Decimal(10, 2)
  expectedCash Decimal?      @map("expected_cash") @db.Decimal(10, 2)
  actualCash  Decimal?       @map("actual_cash") @db.Decimal(10, 2)
  variance    Decimal?       @db.Decimal(10, 2)
  status      String         @default("OPEN")
  notes       String?        @db.Text
  movements   CashMovement[]

  @@map("cash_shifts")
}

model CashMovement {
  id            Int       @id @default(autoincrement())
  shiftId       Int       @map("shift_id")
  shift         CashShift @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  amount        Decimal   @db.Decimal(10, 2)
  type          String    // OPENING, SALE, RETURN, CASH_IN, CASH_OUT, SAFE_DROP, BANK_DEPOSIT, ADJUSTMENT, CLOSING
  referenceType String?   @map("reference_type")
  referenceId   Int?      @map("reference_id")
  remarks       String?   @db.Text
  createdBy     Int?      @map("created_by")
  creator       User?     @relation(fields: [createdBy], references: [id], onDelete: SetNull)
  createdAt     DateTime  @default(now()) @map("created_at")

  @@map("cash_movements")
}
