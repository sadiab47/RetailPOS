# ==========================================
# RetailPOS Environment Configuration Example
# ==========================================

# 1. Database Connection String (MySQL/MariaDB)
# Format: mysql://[username]:[password]@[host]:[port]/[database_name]
DATABASE_URL="mysql://root:@localhost:3306/retailpos"

# 2. JWT Tokens Authentication Secrets & Expiry Settings
# Change these values in production to secure access credentials!
JWT_SECRET="super_secret_jwt_key_retailpos_2026_xyz"
JWT_EXPIRES_IN="15m"
REFRESH_TOKEN_EXPIRES_IN="7d"

# 3. Application Operational Ports
PORT=4000
FRONTEND_PORT=3000
